{
  "name": "waka-next",
  "version": "4.0.7",
  "homepage": "https://github.com/consindo/waka-next",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev:realtime & npm run dev:orchestrator & npm run dev:web",
    "dev:realtime": "cd apps/realtime && vite dev",
    "dev:orchestrator": "cd apps/orchestrator && vite dev",
    "dev:web": "cd apps/web && vite dev",
    "build": "npm run build:realtime && npm run build:orchestrator && npm run build:web",
    "build:realtime": "cd apps/realtime && vite build",
    "build:orchestrator": "cd apps/orchestrator && vite build",
    "build:web": "cd apps/web && vite build",
    "preview": "npm run preview:realtime & npm run preview:orchestrator & npm run preview:web",
    "preview:realtime": "cd apps/realtime && vite preview",
    "preview:orchestrator": "cd apps/orchestrator && vite preview",
    "preview:web": "cd apps/web && PUBLIC_GTFS_ENDPOINT=http://localhost:4174 PUBLIC_GTFS_REALTIME_ENDPOINT=http://localhost:4175 vite preview",
    "check": "npm run check:realtime && npm run check:orchestrator && npm run check:web",
    "check:realtime": "cd apps/realtime && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:orchestrator": "cd apps/orchestrator && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:web": "cd apps/web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@gera2ld/tarjs": "^0.3.1",
    "@loaders.gl/core": "^4.5.4",
    "@loaders.gl/wkt": "^4.5.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@zip.js/zip.js": "^2.24.0",
    "confbox": "^0.3.1",
    "date-fns": "^4.4.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.15.0",
    "sql.js": "^1.15.1",
    "udsv": "^0.7.3"
  }
}
